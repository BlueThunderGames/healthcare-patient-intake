# Copy this file to .env and fill in real values for your local environment.
# .env is gitignored; .env.example is tracked so the required variables are documented.

# Runtime environment. Production enables secure-only session cookies.
NODE_ENV="development"

# Local Postgres connection (matches docker-compose.yml's default credentials).
# Change the password here AND in docker-compose.yml if you customize it.
DATABASE_URL="postgresql://healthcare:healthcare_dev_password@localhost:5432/healthcare?schema=public"

# Port the Express server listens on.
PORT=4000

# Origin allowed to make credentialed cross-origin requests (see CORS decision
# in HEALTHCARE_PROJECT_PLAN.md, Section 3). Must match the Next.js dev server.
CLIENT_ORIGIN="http://localhost:3000"
